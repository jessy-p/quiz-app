# Copy to .env.local for local development. All optional: the app works
# fully without any of these (progress lives in the browser's localStorage).

# Vercel Blob store token — enables the optional progress backup.
# Created automatically when you connect a Blob store in Vercel.
BLOB_READ_WRITE_TOKEN=

# Shared secret that locks the backup endpoint to your own devices.
# Generate one with: openssl rand -hex 16
# Then open your app once per device as /?backup=<secret> to opt it in.
BACKUP_SECRET=
